# Template only. Do not put passwords here or commit a populated environment file.
# Install as /etc/catalystcenter-runner/runner.env, root:catalyst-runner, mode 0640.
RUNNER_AUTH_DIR=/var/lib/catalystcenter-runner/auth
RUNNER_HISTORY_DIR=/var/lib/catalystcenter-runner/history
RUNNER_VENV_PYTHON=/srv/catalystcenter-runner/app/.venv312/bin/python
ANSIBLE_LOCAL_TEMP=/var/lib/catalystcenter-runner/ansible-local-tmp
ANSIBLE_REMOTE_TEMP=/var/lib/catalystcenter-runner/ansible-remote-tmp
# Secure cookies stay enabled; browser access will require HTTPS (configured later).
RUNNER_COOKIE_SECURE=true
# Comma-separated administrator-approved hosts for UI Catalyst Center lookups.
# Include every target used for interface/port lookup; no schemes or URL paths.
RUNNER_CATC_ALLOWED_HOSTS=catc.example.test
